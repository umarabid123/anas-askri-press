{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Anas Arki Press and Laser Cutting",
  "version": "1.0.2",
  "identifier": "com.anasarkipress.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Anas Arki Press and Laser Cutting",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0RkYyQTNEMTEwNTQxMzQKUldRMFFRVVJQU3IvTkt3WFhuVUZJSFhxRDA1TGFNMXFQdHVnUlZ0bmVFMWl0R0VLQmlnczYyU2gK",
      "endpoints": [
        "https://github.com/umarabid123/anas-askri-press/releases/latest/download/latest.json"
      ]
    }
  }
}
