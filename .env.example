# Arki POS — Supabase Cloud Database Configuration
# Copy this file to .env or .env.local to enable cloud synchronization
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Private LOCAL SERVER credential. Never use a VITE_ prefix for this value.
# npm run dev starts the local backend and UI together. Do not commit .env.
SUPABASE_SECRET_KEY=your-server-secret-or-service-role-key
